# ---------------------------------------------------------------------------
# Tours & Travel ERP — environment template
#
# Copy to .env and fill in. NEVER commit the real .env.
#
#   cp .env.example .env
#
# The file is parsed by hand in api/config/app.php (no Composer, no dotenv
# package). Supported syntax: KEY=value, KEY="value with spaces", # comments,
# blank lines. Values are NOT exported to getenv()/$_ENV, so a leaked
# phpinfo() page cannot dump them.
#
# Location: api/config/app.php looks for the first readable .env in
#   1. <one level above the application root>/.env   ← production bundle layout
#   2. <application root>/.env                       ← rarely used
# In development the application root is api/, so a repo-root .env is found by
# rule 1. In production the bundle is <site>/.env with the code in
# <site>/backend/, which is also rule 1.
# ---------------------------------------------------------------------------


# --- Application ------------------------------------------------------------

# Shown in the installer banner and available to the API as app.name.
APP_NAME="Tours & Travel ERP"

# development | production
# Anything other than the literal string "development" is treated as production:
# display_errors off, exception messages replaced with "Internal server error",
# and localhost CORS origins rejected. The default when unset is production —
# the config fails closed on purpose.
APP_ENV=development

# Public URL of the SPA. Used to build the password-reset link. Leave blank and
# the reset link is logged as "(set APP_URL to build a link)".
APP_URL=http://localhost:8080

# Any PHP-supported timezone. Also pinned on the MySQL connection as +05:30
# in api/core/Database.php, so changing this alone will not move the DB clock.
APP_TIMEZONE=Asia/Kolkata

# ISO 4217 code used as the reporting currency.
APP_CURRENCY=INR


# --- Database ---------------------------------------------------------------
# MariaDB 10.4+ / MySQL 8+. The database must exist before php api/install.php
# runs; the installer creates tables, not the schema itself.
#
# Create it with an explicit collation — the MariaDB 11.x server default
# (utf8mb4_uca1400_ai_ci) breaks every JOIN against the application's
# utf8mb4_unicode_ci tables with errno 1267:
#
#   CREATE DATABASE tours_erp
#     CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

DB_HOST=localhost
DB_PORT=3306
DB_NAME=tours_erp
DB_USER=root
DB_PASS=


# --- Authentication ---------------------------------------------------------
# JWT_SECRET signs every access token. api/index.php refuses to boot and
# returns 500 "Server misconfiguration" when it is empty, shorter than 32
# characters, or still the literal string "change-me".
#
# Generate a fresh one per environment — never reuse the development secret in
# production, and never commit a real value here:
#
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
#
JWT_SECRET=change-me

# The `iss` claim. A token minted by another issuer is rejected at decode time,
# so changing this invalidates every token already in circulation.
JWT_ISSUER=tours-travel-erp


# --- CORS -------------------------------------------------------------------
# Comma-separated EXACT-match origin allowlist. Never "*", never a wildcard
# subdomain, never a substring match. Origins must include the scheme and, when
# non-standard, the port.
#
# Outside production only, any http(s) origin whose host is localhost, 127.0.0.1
# or ::1 is additionally accepted, so the Vite dev server works without anyone
# adding a localhost entry to the production allowlist.
#
# Same-origin production deployments (the SPA served from the same host as the
# /api bridge) need no value at all.
CORS_ORIGIN=http://localhost:8080


# ---------------------------------------------------------------------------
# NOT read from this file
# ---------------------------------------------------------------------------
#
# ADMIN_PASSWORD — read by api/install.php with getenv(), which deliberately
# does not see this file. Pass it as a real shell variable so the bootstrap
# password never lands on disk:
#
#   ADMIN_PASSWORD='...' php api/install.php --email=owner@example.com
#
# Omit it entirely and the installer generates a 16-character password, prints
# it once, and sets must_change_pw on the account.
#
#
# VITE_* — read by the frontend at BUILD time via import.meta.env, and Vite only
# loads .env files from its own root. They belong in frontend/.env, not here:
#
#   frontend/.env
#   ------------------------------------------------------------------
#   VITE_API_BASE_URL=/api                  # default when unset: /api
#   VITE_APP_NAME="Tours & Travel ERP"      # default: Tours & Travel ERP
#   VITE_DEFAULT_CURRENCY=INR               # default: INR
#
# In local development VITE_API_BASE_URL should stay /api: vite.config.ts
# proxies /api to http://localhost:8000 and strips the prefix. deploy.sh builds
# production with VITE_API_BASE_URL=/api for the same reason — the SPA and the
# API bridge share an origin.
