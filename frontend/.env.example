# Copy to .env.local for local development. Only VITE_* keys reach the browser —
# never put a secret in this file.

# Base URL for the REST API. Leave as "/api" to use the Vite dev proxy locally
# and the same-origin bridge (public_html/api/index.php) in production.
VITE_API_BASE_URL=/api

# Shown in the sidebar header and on printed documents.
VITE_APP_NAME=Tours & Travel ERP

# Default reporting currency (ISO 4217). Used by formatMoney when a row carries
# no currency of its own.
VITE_DEFAULT_CURRENCY=INR
